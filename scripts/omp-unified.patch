+async function fetchOpenRouterAvailableCredits(
+	apiKey: string,
+	fetchImpl: (input: string | URL | Request, init?: RequestInit) => Promise<Response>,
+): Promise<number | undefined> {
+	const response = await fetchImpl(OPENROUTER_CREDITS_URL, {
+		headers: {
